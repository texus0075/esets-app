rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: properties
    // Document ID: auto-generated or custom property ID string
    // Required Fields:
    //   - title: string (required, 1-300 chars) - Property headline/title
    //   - price: number (required, > 0 and <= 100,000,000,000) - Price in INR
    //   - userId: string (required, 1-128 chars, immutable) - Creator's Firebase Auth UID
    // Optional Fields (Empty strings "", null, or standard values are permitted):
    //   - locality: string (optional) - Locality / neighborhood name
    //   - district: string (optional) - District name
    //   - state: string (optional) - State name
    //   - pincode: string | number (optional) - Postal code
    //   - category: string (optional) - Property category (Houses & Villas, Flats, etc.)
    //   - dealType: string (optional) - Sale / Rent / Lease
    //   - priceUnit: string (optional) - Display price (e.g. '₹1.25 Cr')
    //   - pricePerSqft: string (optional) - Formatted price per sq.ft
    //   - savingsBrokerage: string (optional) - Calculated brokerage savings
    //   - area: number (optional) - Super / built-up area
    //   - carpetArea: number (optional) - Carpet area
    //   - bhk: number (optional) - Number of bedrooms
    //   - bathrooms: number (optional) - Number of bathrooms
    //   - facing: string (optional) - Direction / Vastu orientation
    //   - ownership: string (optional) - Title deed / freehold type
    //   - description: string (optional) - Full property description
    //   - images: list (optional, <= 50 items) - Photos and media URLs
    //   - videoUrl: string (optional) - Video tour URL
    //   - sellerName: string (optional) - Contact person / owner name
    //   - sellerPhone: string (optional) - Direct telephone / contact number
    //   - sellerType: string (optional) - Direct owner verification badge
    //   - sellerAvatar: string (optional) - Profile / avatar photo URL
    //   - postedAt: string (optional) - Formatted posting date
    //   - isSold: bool (optional) - 'Sold It' Call Shield toggle flag
    //   - soldAt: string | timestamp (optional) - Timestamp when marked sold
    //   - status: string (optional) - Property lifecycle status
    //   - verifiedOwner: bool (optional) - Direct owner verification status
    //   - has360: bool (optional) - 360 virtual tour flag
    //   - furnishing: string (optional) - Furnishing status
    //   - floorLevel: string (optional) - Floor level
    //   - coords: string (optional) - GPS coordinates string
    //   - callingHours: string (optional) - Allowed calling window
    //   - landmarks: list (optional, <= 50 items) - Contextual landmark cards
    //   - views: number (optional) - Listing view counter
    //   - createdAt: string | timestamp (optional, immutable) - Creation time
    //   - serverTime: timestamp (optional, immutable) - Server timestamp
    //   - id: string (optional, immutable) - Client identifier mirror
    //
    // Collection: users
    // Document ID: userId (must match request.auth.uid)
    // Fields:
    //   - uid: string (required, 1-128 chars, immutable) - Firebase Auth UID
    //   - email: string (required, valid email) - User's email
    //   - displayName: string (optional) - Full name
    //   - phoneNumber: string (optional) - Contact phone number
    //   - photoURL: string (optional) - Avatar URL
    //   - role: string (optional, 'owner' | 'buyer' | 'user') - Standard role
    //   - verified: bool (optional) - Account status badge
    //   - createdAt: string | timestamp (optional, immutable) - Creation timestamp
    //   - updatedAt: string | timestamp (optional) - Update timestamp
    //
    // Collection: inquiries
    // Document ID: auto-generated or custom inquiry ID string
    // Fields:
    //   - propertyId: string (optional) - Target property ID
    //   - propertyTitle: string (optional) - Property headline
    //   - buyerName: string (optional) - Interested buyer name
    //   - buyerPhone: string (optional) - Buyer contact number
    //   - sellerId: string (optional) - Property seller UID
    //   - sellerPhone: string (optional) - Seller phone number
    //   - status: string (optional) - Inquiry state (e.g. 'new', 'contacted')
    //   - message: string (optional) - Buyer query or custom note
    //   - visitDate: string (optional) - Requested site visit date
    //   - createdAt: string | timestamp (optional) - Submission timestamp
    //   - serverTime: timestamp (optional) - Server timestamp
    //
    // ===============================================================

    // ===============================================================
    // Global Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ===============================================================
    // Domain Validator: properties (Streamlined for CEL Step Budget)
    // ===============================================================

    function isValidProperty(data) {
      return ('title' in data) &&
             ('price' in data) &&
             ('userId' in data) &&
             // Mandatory fields validation
             data.title is string && data.title.size() > 0 && data.title.size() <= 300 &&
             data.price is number && data.price > 0 && data.price <= 100000000000 &&
             data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             // Inlined optional field checks (eliminates 30+ helper function call frames)
             (!('locality' in data) || data.locality is string) &&
             (!('district' in data) || data.district is string) &&
             (!('state' in data) || data.state is string) &&
             (!('pincode' in data) || data.pincode == null || data.pincode is string || data.pincode is number) &&
             (!('category' in data) || data.category is string) &&
             (!('dealType' in data) || data.dealType is string) &&
             (!('priceUnit' in data) || data.priceUnit is string) &&
             (!('pricePerSqft' in data) || data.pricePerSqft is string) &&
             (!('savingsBrokerage' in data) || data.savingsBrokerage is string) &&
             (!('area' in data) || data.area is number) &&
             (!('carpetArea' in data) || data.carpetArea is number) &&
             (!('bhk' in data) || data.bhk is number) &&
             (!('bathrooms' in data) || data.bathrooms is number) &&
             (!('facing' in data) || data.facing is string) &&
             (!('ownership' in data) || data.ownership is string) &&
             (!('status' in data) || data.status is string) &&
             (!('furnishing' in data) || data.furnishing is string) &&
             (!('description' in data) || data.description == null || data.description is string) &&
             (!('images' in data) || data.images == null || (data.images is list && data.images.size() <= 50)) &&
             (!('videoUrl' in data) || data.videoUrl == null || data.videoUrl is string) &&
             (!('sellerName' in data) || data.sellerName is string) &&
             (!('sellerPhone' in data) || data.sellerPhone == null || data.sellerPhone is string) &&
             (!('sellerType' in data) || data.sellerType is string) &&
             (!('sellerAvatar' in data) || data.sellerAvatar is string) &&
             (!('postedAt' in data) || data.postedAt is string) &&
             (!('floorLevel' in data) || data.floorLevel is string) &&
             (!('coords' in data) || data.coords is string) &&
             (!('callingHours' in data) || data.callingHours is string) &&
             (!('landmarks' in data) || data.landmarks == null || (data.landmarks is list && data.landmarks.size() <= 50)) &&
             (!('views' in data) || data.views is number) &&
             (!('isSold' in data) || data.isSold is bool) &&
             (!('verifiedOwner' in data) || data.verifiedOwner is bool) &&
             (!('has360' in data) || data.has360 is bool) &&
             (!('createdAt' in data) || data.createdAt is string || data.createdAt is timestamp || data.createdAt == request.time) &&
             (!('soldAt' in data) || data.soldAt == null || data.soldAt is string || data.soldAt is timestamp || data.soldAt == request.time) &&
             (!('serverTime' in data) || data.serverTime == null || data.serverTime is timestamp || data.serverTime == request.time);
    }

    function isValidPropertyUpdate() {
      return isValidProperty(request.resource.data) &&
             // Protect immutable fields from unauthorized changes on update
             request.resource.data.userId == resource.data.userId &&
             (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
             (!('id' in resource.data) || request.resource.data.id == resource.data.id) &&
             (!('serverTime' in resource.data) || request.resource.data.serverTime == resource.data.serverTime);
    }

    function isViewsIncrementOnly() {
      // Allows anyone viewing the property to increment the view counter atomically by +1
      // Strictly forbids modifying any other fields (such as price, isSold, userId, etc.)
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']) &&
             request.resource.data.views is number &&
             (('views' in resource.data && resource.data.views is number) ?
               (request.resource.data.views == resource.data.views + 1) :
               (request.resource.data.views == 1));
    }

    // ===============================================================
    // Domain Validator: users
    // ===============================================================

    function isValidUser(data) {
      return ('uid' in data) &&
             ('email' in data) &&
             data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 150 &&
             (!('displayName' in data) || data.displayName is string) &&
             (!('phoneNumber' in data) || data.phoneNumber == null || data.phoneNumber is string) &&
             (!('photoURL' in data) || data.photoURL == null || data.photoURL is string) &&
             (!('role' in data) || data.role in ['owner', 'buyer', 'user']) &&
             (!('verified' in data) || data.verified is bool) &&
             (!('createdAt' in data) || data.createdAt is string || data.createdAt is timestamp || data.createdAt == request.time) &&
             (!('updatedAt' in data) || data.updatedAt is string || data.updatedAt is timestamp || data.updatedAt == request.time);
    }

    function isValidUserCreate(userId) {
      return isValidUser(request.resource.data) &&
             request.resource.data.uid == userId &&
             request.resource.data.uid == request.auth.uid;
    }

    function isValidUserUpdate(userId) {
      return isValidUser(request.resource.data) &&
             request.resource.data.uid == resource.data.uid &&
             request.resource.data.uid == userId &&
             (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt);
    }

    // ===============================================================
    // Domain Validator: inquiries
    // ===============================================================

    function isValidInquiry(data) {
      return (!('propertyId' in data) || data.propertyId is string) &&
             (!('propertyTitle' in data) || data.propertyTitle is string) &&
             (!('buyerName' in data) || data.buyerName is string) &&
             (!('buyerPhone' in data) || data.buyerPhone == null || data.buyerPhone is string) &&
             (!('sellerId' in data) || data.sellerId is string) &&
             (!('sellerPhone' in data) || data.sellerPhone == null || data.sellerPhone is string) &&
             (!('status' in data) || data.status is string) &&
             (!('message' in data) || data.message == null || data.message is string) &&
             (!('visitDate' in data) || data.visitDate is string) &&
             (!('createdAt' in data) || data.createdAt is string || data.createdAt is timestamp || data.createdAt == request.time) &&
             (!('serverTime' in data) || data.serverTime == null || data.serverTime is timestamp || data.serverTime == request.time);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Properties Collection (Real Estate Marketplace)
    match /properties/{propertyId} {
      // 1. Anyone can browse and search real estate listings
      allow read: if true;

      // 2. Authenticated users can create listings, binding ownership to their auth UID
      allow create: if isAuthenticated() &&
                       request.resource.data.userId == request.auth.uid &&
                       isValidProperty(request.resource.data);

      // 3. Updates: Listing owner can update their property details and 'isSold' toggle,
      //    OR any user (logged in or guest) can increment the listing's view counter by +1
      allow update: if (isOwner(resource.data.userId) && isValidPropertyUpdate()) ||
                       isViewsIncrementOnly();

      // 4. Deletions: Only the creator of the property can delete it
      allow delete: if isOwner(resource.data.userId);
    }

    // Users Collection (Private Profiles & User Identity)
    match /users/{userId} {
      // Strict ownership boundary: Users can only read, create, and update their own document
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserCreate(userId);
      allow update: if isOwner(userId) && isValidUserUpdate(userId);
      allow delete: if isOwner(userId);
    }

    // Inquiries Collection (Buyer Direct Site Visit & Contact Requests)
    match /inquiries/{inquiryId} {
      // 1. Authenticated users can read site visit requests
      allow read: if isAuthenticated();

      // 2. Anyone (including unauthenticated guest buyers) can request a free site visit
      allow create: if isValidInquiry(request.resource.data);

      // 3. Authenticated users can update or delete inquiries
      allow update: if isAuthenticated() && isValidInquiry(request.resource.data);
      allow delete: if isAuthenticated();
    }

    // Catch-all Default Deny: Deny all access across any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
